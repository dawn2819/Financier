<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_container"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/outline_variant"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Toggle: EXPENSE | INCOME -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_toggle_container"
            android:layout_marginBottom="20dp"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_expense"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/expense"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                app:cornerRadius="24dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_income"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/income_type"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/transparent"
                android:textColor="@color/on_surface_variant"
                app:cornerRadius="24dp"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>

        <!-- Amount display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface_variant"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₫"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Date + Note row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Date picker -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/surface_container_high"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:id="@+id/btn_date"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/date"
                            android:textSize="10sp"
                            android:textColor="@color/on_surface_variant"/>
                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note input -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/surface_container_high"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/note"
                            android:textSize="10sp"
                            android:textColor="@color/on_surface_variant"/>
                        <EditText
                            android:id="@+id/et_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"
                            android:hint="@string/note_hint"
                            android:textColorHint="@color/on_surface_variant"
                            android:padding="0dp"
                            android:maxLines="1"
                            android:imeOptions="actionDone"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Category section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="12dp"/>

        <!-- Category Grid (4 cols) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:useDefaultMargins="false"
            android:layout_marginBottom="16dp">

            <!-- Food -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_food"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_food"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_food"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Transport -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_transport"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_transport"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_transport"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Shopping -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_shopping"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_shopping"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_shopping"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Health -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_health"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_health"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_health"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Entertainment -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_entertain"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_entertainment"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_entertainment"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Housing -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_housing"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_housing"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_housing"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Education -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_edu"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_education"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_education"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Gym -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_gym"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_gym"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_gym"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Bills -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_bills"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_bills"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_bills"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Travel -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_travel"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_travel"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_travel"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Pets -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_pets"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_pets"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_pets"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

            <!-- Others -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_others"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/cat_others"
                android:textSize="10sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_cat_others"
                app:iconGravity="top"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                android:paddingVertical="10dp"/>

        </GridLayout>

        <!-- Numpad -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_container_high"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:padding="8dp">

                <com.google.android.material.button.MaterialButton android:id="@+id/btn1" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="1" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn2" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="2" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn3" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="3" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn4" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="4" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn5" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="5" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn6" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="6" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn7" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="7" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn8" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="8" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn9" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="9" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_dot" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="." android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn0" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/on_surface" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_backspace" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="2dp" app:icon="@drawable/ic_backspace" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/error" android:textColor="@color/error" app:cornerRadius="12dp"/>

            </GridLayout>
        </androidx.cardview.widget.CardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save_transaction"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@color/on_primary"/>

    </LinearLayout>
</LinearLayout>
