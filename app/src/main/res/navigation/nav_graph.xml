<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:anim="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.financier.app.ui.dashboard.DashboardFragment"
        android:label="Home">
        <action
            android:id="@+id/action_dashboard_to_transactions"
            app:destination="@id/transactionsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_dashboard_to_profile"
            app:destination="@id/profileFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_dashboard_to_qr_scan"
            app:destination="@id/qrScanFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_dashboard_to_bills"
            app:destination="@id/billsHubFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.financier.app.ui.transactions.TransactionsFragment"
        android:label="History"/>

    <fragment
        android:id="@+id/servicesHubFragment"
        android:name="com.financier.app.ui.services.ServicesHubFragment"
        android:label="Services">
        <action
            android:id="@+id/action_services_to_budget"
            app:destination="@id/budgetFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_crypto"
            app:destination="@id/cryptoWalletFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_nearby"
            app:destination="@id/nearbyPlacesFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_bank_link"
            app:destination="@id/bankLinkFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_qr"
            app:destination="@id/qrScanFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_transactions"
            app:destination="@id/transactionsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_bills_hub"
            app:destination="@id/billsHubFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_receive_money"
            app:destination="@id/receiveMoneyFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_entertainment_hub"
            app:destination="@id/entertainmentHubFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_services_to_news_feed"
            app:destination="@id/financialNewsFeedFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/billsHubFragment"
        android:name="com.financier.app.ui.services.BillsHubFragment"
        android:label="Hóa đơn &amp; Cước phí" />

    <fragment
        android:id="@+id/receiveMoneyFragment"
        android:name="com.financier.app.ui.services.ReceiveMoneyFragment"
        android:label="Nhận tiền" />

    <fragment
        android:id="@+id/entertainmentHubFragment"
        android:name="com.financier.app.ui.services.EntertainmentHubFragment"
        android:label="Giải trí &amp; Sự kiện">
        <action
            android:id="@+id/action_entertainmentHubFragment_to_billsHubFragment"
            app:destination="@id/billsHubFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/financialNewsFeedFragment"
        android:name="com.financier.app.ui.news.FinancialNewsFeedFragment"
        android:label="Tin tức tài chính" />

    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.financier.app.ui.budget.BudgetFragment"
        android:label="Budget"/>

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.financier.app.ui.reports.ReportsFragment"
        android:label="Reports"/>

    <fragment
        android:id="@+id/aiChatFragment"
        android:name="com.financier.app.ui.ai.AiChatFragment"
        android:label="AI"/>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.financier.app.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_accounts"
            app:destination="@id/manageAccountsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_profile_to_bank_link"
            app:destination="@id/bankLinkFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_profile_to_nearby_places"
            app:destination="@id/nearbyPlacesFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_profile_to_crypto"
            app:destination="@id/cryptoWalletFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/manageAccountsFragment"
        android:name="com.financier.app.ui.profile.ManageAccountsFragment"
        android:label="Accounts"/>

    <fragment
        android:id="@+id/bankLinkFragment"
        android:name="com.financier.app.ui.profile.BankLinkFragment"
        android:label="Bank SMS Link"/>

    <fragment
        android:id="@+id/nearbyPlacesFragment"
        android:name="com.financier.app.ui.nearby.NearbyPlacesFragment"
        android:label="Nearby ATMs and Banks"/>

    <fragment
        android:id="@+id/cryptoWalletFragment"
        android:name="com.financier.app.ui.crypto.CryptoWalletFragment"
        android:label="Crypto wallet"/>

    <fragment
        android:id="@+id/qrScanFragment"
        android:name="com.financier.app.ui.qr.QrScanFragment"
        android:label="Scan QR"/>

</navigation>